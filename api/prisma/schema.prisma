generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      String
  active    Boolean  @default(true)
  unit      Unit?
  createdAt DateTime @default(now())
}

model Unit {
  id          String       @id @default(cuid())
  callsign    String       @unique
  officerName String
  department  String
  type        String
  status      String       @default("available")
  location    String?
  identifier  String?
  userId      String?      @unique
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments Assignment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Call {
  id          String       @id @default(cuid())
  number      Int          @unique
  type        String
  priority    Int
  title       String
  description String
  location    String
  postal      String?
  caller      String?
  status      String
  source      String       @default("console")
  posX        Float?
  posY        Float?
  posZ        Float?
  createdBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  closedAt    DateTime?
  assignments Assignment[]
  notes       CallNote[]
}

model Assignment {
  id         String   @id @default(cuid())
  callId     String
  unitId     String
  call       Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([callId, unitId])
}

model CallNote {
  id        String   @id @default(cuid())
  callId    String
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  author    String
  body      String
  createdAt DateTime @default(now())
}

model Bolo {
  id          String   @id @default(cuid())
  kind        String
  title       String
  description String
  subject     String?
  plate       String?
  risk        String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Person {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  dob       String
  gender    String?
  phone     String?
  address   String?
  license   String    @default("valid")
  flags     String?
  notes     String?
  warrants  Warrant[]
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Vehicle {
  id           String   @id @default(cuid())
  plate        String   @unique
  model        String
  color        String
  ownerId      String?
  owner        Person?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  insurance    String   @default("valid")
  registration String   @default("valid")
  flags        String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Warrant {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  charge    String
  issuedBy  String
  active    Boolean  @default(true)
  notes     String?
  issuedAt  DateTime @default(now())
}

model PanicAlert {
  id          String    @id @default(cuid())
  callsign    String
  unitId      String?
  officerName String
  location    String?
  message     String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  clearedAt   DateTime?
}
